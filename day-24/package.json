{
  "name": "day-24-sign-in-with-ethereum",
  "version": "1.0.0",
  "description": "Day 24: Sign in with Ethereum (EIP-4361) for the Day 1 to-do list, safe against signature replay and phishing",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint \"contracts/**/*.sol\"",
    "build:web": "esbuild public/src/app.js --bundle --minify --format=iife --outfile=public/app.js",
    "chain": "hardhat node",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "app": "node auth/server.js",
    "demo": "hardhat run scripts/attack-demo.js",
    "slither": "slither . --hardhat-ignore-compile",
    "planted-bugs": "python3 scripts/planted-bugs.py"
  },
  "author": "Manish Khadka",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@openzeppelin/contracts": "^5.0.2",
    "chai": "^4.5.0",
    "esbuild": "^0.24.2",
    "ethers": "^6.17.0",
    "fast-check": "^3.23.2",
    "hardhat": "^2.22.17",
    "playwright": "^1.63.0",
    "solc": "^0.8.24",
    "solhint": "^5.2.0"
  },
  "dependencies": {
    "viem": "^2.58.4"
  },
  "private": true
}
