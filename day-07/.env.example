# Copy this file to .env (which git ignores) and fill in your own values.
# Use a TEST-ONLY wallet that has never held real money.

# HTTPS RPC endpoint for Sepolia (Alchemy, Infura, or another provider)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Private key of the test-only deployer wallet: 0x + 64 hex characters
PRIVATE_KEY=

# Etherscan API key (etherscan.io → My Account → API Keys)
ETHERSCAN_API_KEY=

# Day 04 multisig: comma-separated owner addresses and approvals needed
MULTISIG_OWNERS=0xOwnerOne,0xOwnerTwo,0xOwnerThree
MULTISIG_THRESHOLD=2
