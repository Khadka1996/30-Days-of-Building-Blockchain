# Copy to .env (never commit .env). Use a TEST-ONLY wallet with free Sepolia faucet ETH. No real money.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0xYOUR_TEST_ONLY_PRIVATE_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# Who controls the registry. In production: a 2-of-3 Safe multisig. For a test demo you may use the deployer.
COUNCIL_ADDRESS=0xYOUR_COUNCIL_ADDRESS

# Written into app/public/config.json by the deploy script.
APP_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SITE_URL=https://your-pramaan-site.example

# Used by scripts/council.js
ACTION=add-issuer
ISSUER_KEY=0xINSTITUTION_KEY
ISSUER_NAME=National Examinations Board
ISSUER_ID=1
