{
  "name": "day-25-gasless-transactions",
  "version": "1.0.0",
  "description": "Day 25: gasless transactions — EIP-712 signed meta-transactions (ERC-2771) for the Day 1 to-do list, with a relayer that pays the gas and is safe against relayer abuse and nonce reuse",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint \"contracts/**/*.sol\"",
