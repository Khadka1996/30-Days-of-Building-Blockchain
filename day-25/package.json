    "@openzeppelin/contracts": "^5.0.2",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "fast-check": "^3.23.2",
    "hardhat": "^2.22.17",
    "playwright": "1.63",
    "solc": "^0.8.24",
    "solhint": "^5.2.0"
  },
